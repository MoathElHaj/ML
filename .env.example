# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for SEO links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://bariq.example

# WhatsApp number in international format, digits only (e.g. 9689XXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=96894178876

# Time zone for consultation bookings (IANA name)
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Muscat

# Optional contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Meta ads (dashboard → الحملات الإعلانية) ---
# From developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version (default v25.0)
META_GRAPH_VERSION=

# --- AI campaign drafting (Claude) ---
# From console.anthropic.com → API keys. Server-side only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
