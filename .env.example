# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for SEO links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://bariq.example

# WhatsApp number in international format, digits only (e.g. 9689XXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Time zone for consultation bookings (IANA name)
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Muscat

# Optional contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=
